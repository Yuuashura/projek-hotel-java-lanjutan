          <mxGeometry x="550" y="100" width="420" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="b-lane-ext" value="DB + GMAIL" style="swimlane;html=1;horizontal=0;startSize=40;fillColor=#fef3c7;strokeColor=#d97706;fontStyle=1;fontColor=#78350f;" vertex="1" parent="b1">
          <mxGeometry x="970" y="100" width="330" height="730" as="geometry"/>
        </mxCell>
        <mxCell id="b-start" value="Mulai" style="ellipse;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="b1">
          <mxGeometry x="85" y="135" width="110" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="b-choice" value="Pilih proses" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontStyle=1;" vertex="1" parent="b1">
          <mxGeometry x="80" y="220" width="120" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b-reg-form" value="Isi form register" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="b1">
          <mxGeometry x="320" y="135" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="b-reg-api" value="POST /api/auth/register&lt;br&gt;Validasi + hash password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="b1">
          <mxGeometry x="640" y="135" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="b-reg-save" value="Simpan customer&lt;br&gt;Buat OTP REGISTER" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f3f4f6;strokeColor=#4b5563;" vertex="1" parent="b1">
          <mxGeometry x="1040" y="135" width="180" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="b-email" value="Kirim kode OTP&lt;br&gt;via Gmail SMTP" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;" vertex="1" parent="b1">
          <mxGeometry x="1040" y="245" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-otp-form" value="Masukkan OTP 6 digit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="b1">
          <mxGeometry x="320" y="245" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="b-verify" value="POST /verify-otp&lt;br&gt;Purpose = REGISTER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="b1">
          <mxGeometry x="640" y="245" width="220" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="b-valid" value="OTP valid dan belum expired?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;" vertex="1" parent="b1">
          <mxGeometry x="680" y="350" width="150" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b-active" value="Aktifkan akun&lt;br&gt;OTP used = true" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="b1">
          <mxGeometry x="1040" y="365" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="b-login-form" value="Isi email + password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="b1">
          <mxGeometry x="320" y="480" width="170" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="b-login-api" value="POST /api/auth/login&lt;br&gt;Cek password + banned + verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="b1">
          <mxGeometry x="640" y="475" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="b-jwt" value="Generate JWT&lt;br&gt;userId + email + role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;" vertex="1" parent="b1">
          <mxGeometry x="1040" y="475" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="b-route" value="Simpan token&lt;br&gt;ROLE_USER → Home&lt;br&gt;ROLE_ADMIN_* → Dashboard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="b1">
          <mxGeometry x="315" y="585" width="180" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="b-forgot" value="Forgot Password&lt;br&gt;Masukkan email" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;" vertex="1" parent="b1">
          <mxGeometry x="315" y="705" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="b-reset-api" value="POST /forgot-password&lt;br&gt;Buat OTP PASSWORD_RESET&lt;br&gt;→ verify-reset-otp&lt;br&gt;→ reset-password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;" vertex="1" parent="b1">
          <mxGeometry x="630" y="685" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="b-reset-db" value="Validasi OTP&lt;br&gt;Update password hash&lt;br&gt;Invalidasi token" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f3f4f6;strokeColor=#4b5563;" vertex="1" parent="b1">
          <mxGeometry x="1040" y="690" width="180" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="b-error" value="Tampilkan error / kirim ulang OTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;" vertex="1" parent="b1">
          <mxGeometry x="315" y="365" width="180" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="b-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-start" target="b-choice"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" value="Register" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-choice" target="b-reg-form"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-reg-form" target="b-reg-api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-reg-api" target="b-reg-save"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-reg-save" target="b-email"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-email" target="b-otp-form"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-otp-form" target="b-verify"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="b1" source="b-verify" target="b-valid"><mxGeometry relative="1" as="geometry"/></mxCell>
