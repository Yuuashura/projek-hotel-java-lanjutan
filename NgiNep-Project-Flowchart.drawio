          <mxGeometry x="1340" y="90" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="a-xendit" value="&lt;b&gt;XENDIT&lt;/b&gt;&lt;br&gt;Create invoice&lt;br&gt;Hosted payment page&lt;br&gt;Webhook PAID / EXPIRED" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#fce7f3;strokeColor=#db2777;fontColor=#831843;fontSize=13;shadow=1;" vertex="1" parent="1">
