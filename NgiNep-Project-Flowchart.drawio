<mxfile host="app.diagrams.net" modified="2026-06-20T00:00:00.000Z" agent="Codex" version="24.7.17" type="device">
  <diagram id="architecture" name="1. Arsitektur Sistem">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="a-title" value="&lt;b&gt;NgiNep - Arsitektur Sistem Microservices&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;React/Vite, Spring Cloud Gateway, Spring Boot services, PostgreSQL, Gmail, dan Xendit&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="300" y="30" width="1000" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a-user" value="&lt;b&gt;USER&lt;/b&gt;&lt;br&gt;Cari hotel&lt;br&gt;Booking kamar&lt;br&gt;Bayar &amp;amp; lihat status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#1e3a8a;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="235" width="170" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="a-admin" value="&lt;b&gt;ADMIN&lt;/b&gt;&lt;br&gt;Kelola hotel/kamar&lt;br&gt;Kelola booking&lt;br&gt;Export Excel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="170" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="a-frontend" value="&lt;b&gt;FRONTEND - React 19 + Vite&lt;/b&gt;&lt;br&gt;&lt;br&gt;Public: Home, Hotels, Detail, About&lt;br&gt;Auth: Login, Register, OTP, Reset Password&lt;br&gt;User: Booking, Payment, My Bookings, Profile&lt;br&gt;Admin: Dashboard, Hotels, Rooms, Bookings, Users&lt;br&gt;&lt;br&gt;PreferencesContext: tema + ID/EN&lt;br&gt;AuthContext: JWT + role guard" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;fontColor=#172554;fontSize=14;shadow=1;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="280" y="175" width="300" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="a-gateway" value="&lt;b&gt;API GATEWAY :8080&lt;/b&gt;&lt;br&gt;Spring Cloud Gateway&lt;br&gt;&lt;br&gt;/api/auth/**, /api/users/**&lt;br&gt;/api/hotels/**, /api/room-types/**&lt;br&gt;/api/cities/**, /api/facilities/**&lt;br&gt;/api/bookings/**&lt;br&gt;&lt;br&gt;CORS + rate limit + routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#4c1d95;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="260" width="240" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="a-user-service" value="&lt;b&gt;USER SERVICE :8081&lt;/b&gt;&lt;br&gt;Auth + JWT + role&lt;br&gt;Register &amp;amp; OTP email&lt;br&gt;Forgot/reset password&lt;br&gt;Profile &amp;amp; user management" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="120" width="245" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="a-hotel-service" value="&lt;b&gt;HOTEL SERVICE :8082&lt;/b&gt;&lt;br&gt;Hotel + room type&lt;br&gt;City + facility&lt;br&gt;Filter + pagination&lt;br&gt;Upload image &amp;amp; Excel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontColor=#7c2d12;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="335" width="245" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="a-booking-service" value="&lt;b&gt;BOOKING SERVICE :8083&lt;/b&gt;&lt;br&gt;Booking &amp;amp; availability&lt;br&gt;Anti overselling&lt;br&gt;Payment manual / Xendit&lt;br&gt;Status + email + export Excel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#ca8a04;fontColor=#713f12;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="550" width="245" height="150" as="geometry"/>
