        <mxCell id="c-login" value="Sudah login&lt;br&gt;ROLE_USER?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#78350f;" vertex="1" parent="c1">
