        <mxCell id="a-db" value="&lt;b&gt;POSTGRESQL / SUPABASE&lt;/b&gt;&lt;br&gt;&lt;br&gt;customers + otp_tokens&lt;br&gt;hotels + room_types + facilities&lt;br&gt;bookings + payment fields&lt;br&gt;&lt;br&gt;JPA / Hibernate" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=18;fillColor=#f3f4f6;strokeColor=#4b5563;fontColor=#111827;fontSize=14;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="1340" y="250" width="210" height="250" as="geometry"/>
        </mxCell>
