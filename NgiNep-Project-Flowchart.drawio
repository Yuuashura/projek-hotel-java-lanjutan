        <mxCell id="c-title" value="&lt;b&gt;Flow Pencarian Hotel, Booking, Availability, dan Pembayaran Xendit&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontColor=#172554;" vertex="1" parent="c1">
