        <mxCell id="c-login-page" value="Arahkan ke /login&lt;br&gt;lalu kembali booking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;" vertex="1" parent="c1">
