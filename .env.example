# Database user-service
USER_DB_URL=your_user_database_url
USER_DB_USERNAME=your_user_database_username
USER_DB_PASSWORD=your_user_database_password

# Database hotel-service
HOTEL_DB_URL=your_hotel_database_url
HOTEL_DB_USERNAME=your_hotel_database_username
HOTEL_DB_PASSWORD=your_hotel_database_password

# Database booking-service
BOOKING_DB_URL=your_booking_database_url
BOOKING_DB_USERNAME=your_booking_database_username
BOOKING_DB_PASSWORD=your_booking_database_password

# Shared backend configuration
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JWT_SECRET=change_this_to_long_random_secret
JWT_EXPIRATION=3600000

# SMTP
SPRING_MAIL_USERNAME=your_email
SPRING_MAIL_PASSWORD=your_app_password

# Login rate limiting
LOGIN_RATE_LIMIT_EMAIL_IP=10
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Xendit
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_API_KEY=your_xendit_api_key
XENDIT_CALLBACK_TOKEN=your_xendit_callback_token
XENDIT_SUCCESS_REDIRECT_URL=https://hotel.yuuashura.my.id/my-bookings
XENDIT_FAILURE_REDIRECT_URL=https://hotel.yuuashura.my.id/my-bookings

# Production public URLs
APP_URL=https://hotel.yuuashura.my.id
CORS_ALLOWED_ORIGINS=https://hotel.yuuashura.my.id
VITE_API_URL=https://api-hotel.yuuashura.my.id
TRUSTED_PROXY_HOPS=1

# Internal Docker service URLs
USER_SERVICE_URL=http://user-service:8081
HOTEL_SERVICE_URL=http://hotel-service:8082
BOOKING_SERVICE_URL=http://booking-service:8083

# Optional local ngrok profile only
NGROK_AUTHTOKEN=your_ngrok_authtoken
NGROK_URL=https://your-ngrok-domain.ngrok-free.app
