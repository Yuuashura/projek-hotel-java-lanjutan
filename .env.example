# Managed PostgreSQL databases
USER_DB_URL=jdbc:postgresql://HOST:5432/USER_DATABASE?sslmode=require&prepareThreshold=0
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=replace_me

HOTEL_DB_URL=jdbc:postgresql://HOST:5432/HOTEL_DATABASE?sslmode=require&prepareThreshold=0
HOTEL_DB_USERNAME=postgres
HOTEL_DB_PASSWORD=replace_me

BOOKING_DB_URL=jdbc:postgresql://HOST:5432/BOOKING_DATABASE?sslmode=require&prepareThreshold=0
BOOKING_DB_USERNAME=postgres
BOOKING_DB_PASSWORD=replace_me

# Shared Spring/JPA configuration
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Shared JWT configuration (must be identical for all backend services)
JWT_SECRET=replace_with_a_random_secret_that_is_at_least_64_characters_long_1234567890
JWT_EXPIRATION=3600000

# Gmail SMTP
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password

# Login rate limiting
LOGIN_RATE_LIMIT_EMAIL_IP=10
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Xendit payment integration
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_API_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_SUCCESS_REDIRECT_URL=https://deciduous-unfurrowed-august.ngrok-free.dev/my-bookings
XENDIT_FAILURE_REDIRECT_URL=https://deciduous-unfurrowed-august.ngrok-free.dev/my-bookings
APP_URL=https://deciduous-unfurrowed-august.ngrok-free.dev

# Internal Docker service URLs and gateway configuration
USER_SERVICE_URL=http://user-service:8081
HOTEL_SERVICE_URL=http://hotel-service:8082
BOOKING_SERVICE_URL=http://booking-service:8083
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://deciduous-unfurrowed-august.ngrok-free.dev
TRUSTED_PROXY_HOPS=0

# ngrok
NGROK_AUTHTOKEN=replace_with_your_ngrok_authtoken
NGROK_URL=https://deciduous-unfurrowed-august.ngrok-free.dev
