server.port=8083

# ===================== DATABASE =====================
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/ngninep_booking}
spring.datasource.username=${DB_USERNAME:postgres}
spring.datasource.password=${DB_PASSWORD:postgres}
spring.datasource.driver-class-name=org.postgresql.Driver

# ===================== JPA =====================
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.properties.hibernate.format_sql=true

# ===================== JWT =====================
jwt.secret=${JWT_SECRET:change-this-minimum-32-character-secret}
jwt.expiration=${JWT_EXPIRATION:3600000}

# ===================== XENDIT =====================
xendit.base-url=${XENDIT_BASE_URL:https://api.xendit.co}
xendit.api-key=${XENDIT_API_KEY:}
xendit.callback-token=${XENDIT_CALLBACK_TOKEN:}
xendit.success-redirect-url=${XENDIT_SUCCESS_REDIRECT_URL:http://localhost:5173/my-bookings}
xendit.failure-redirect-url=${XENDIT_FAILURE_REDIRECT_URL:http://localhost:5173/my-bookings}

# ===================== FILE UPLOAD =====================
app.file.upload-path=${APP_FILE_UPLOAD_PATH:uploads/booking-service}
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB
